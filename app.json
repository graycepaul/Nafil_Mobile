{
  "expo": {
    "name": "Nafil Estates",
    "slug": "nafil-estate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.graycepaul.nafilestate",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.graycepaul.nafilestate",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nafil Estates to access your camera to scan visitor QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-splash-screen",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nafil Estates to access your photos to set a profile picture or add photos to a marketplace listing.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#084DA5",
          "sounds": [
            "./assets/sounds/emergency_alert.wav"
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "nafil-estates",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9628b28f-924b-49a3-b652-e0327360c7d9"
      }
    },
    "owner": "graycepaul",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9628b28f-924b-49a3-b652-e0327360c7d9"
    }
  }
}
