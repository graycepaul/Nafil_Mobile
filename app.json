{
  "expo": {
    "name": "nafil-estates",
    "slug": "nafil-estate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.graycepaul.nafilestate",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.graycepaul.nafilestate",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nafil Estates to access your camera to scan visitor QR codes."
        }
      ],
      "expo-splash-screen",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nafil Estates to access your photos so you can set a profile picture."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#084DA5",
          "sounds": ["./assets/sounds/emergency_alert.wav"]
        }
      ]
    ],
    "scheme": "nafil-estates",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9628b28f-924b-49a3-b652-e0327360c7d9"
      }
    },
    "owner": "graycepaul"
  }
}
